# ===== REQUIRED =====

# Apify API token (for Google Maps scraping)
# Get it at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Google OAuth credentials file path
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ===== OPTIONAL =====

# EnrichLayer API key (for LinkedIn profile lookup - currently unused in pipeline)
# ENRICHLAYER_API_KEY=your_key_here
