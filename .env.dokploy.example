# Required secrets: configure values in Dokploy, never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://ambs:replace-with-the-url-encoded-postgres-password@postgres:5432/ambs
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APIFY_API_TOKEN=apify_api_replace_me

# Production defaults
POSTGRES_DB=ambs
POSTGRES_USER=ambs
APP_NAME=AMBS Outreach
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://war.ambs-agency.com
DRY_RUN=true
OPENAI_MODEL=gpt-5.4-mini

# Optional providers
OPENAI_API_KEY=
EMELIA_API_KEY=
EMELIA_API_URL=https://graphql.emelia.io/graphql
EMELIA_SENDER_EMAIL=ambs.suivi@ambs-ia.com
ISENDPRO_KEY_ID=
ISENDPRO_API_URL=https://apirest.isendpro.com/cgi-bin
AMBS_API_KEY=
AMBS_API_URL=
AMBS_SENDER_ID=
